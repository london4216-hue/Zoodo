{
  "name": "SensoryActivity",
  "type": "object",
  "properties": {
    "kid_id": {
      "type": "string",
      "title": "Kid ID",
      "description": "Reference to the Kid this activity belongs to"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "title": "Week Start",
      "description": "The Monday date of this week (ISO)"
    },
    "index": {
      "type": "number",
      "title": "Index",
      "description": "1-3 position of the activity in the week"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "icon": {
      "type": "string",
      "title": "Icon",
      "enum": [
        "sparkles",
        "music",
        "hand",
        "count",
        "color",
        "shape"
      ],
      "default": "sparkles"
    },
    "gesture": {
      "type": "string",
      "title": "Gesture",
      "enum": [
        "clap",
        "wave",
        "point",
        "count"
      ],
      "default": "clap"
    },
    "movement_prompts": {
      "type": "array",
      "title": "Movement Prompts",
      "items": {
        "type": "string"
      }
    },
    "script": {
      "type": "string",
      "title": "Voice Script",
      "description": "The expressive teaching-voice narration"
    },
    "audio_url": {
      "type": "string",
      "title": "Audio URL",
      "description": "TTS narration in the signature EduPath voice"
    },
    "video": {
      "type": "object",
      "title": "Supporting Video",
      "description": "A kid-friendly YouTube video that supports this activity's skill",
      "properties": {
        "video_id": {
          "type": "string",
          "title": "YouTube Video ID"
        },
        "title": {
          "type": "string",
          "title": "Video Title"
        },
        "channel": {
          "type": "string",
          "title": "Channel"
        },
        "why": {
          "type": "string",
          "title": "Why It Supports This Skill"
        }
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "skipped"
      ],
      "default": "not_started"
    },
    "archived": {
      "type": "boolean",
      "title": "Archived",
      "default": false
    }
  },
  "required": [
    "kid_id",
    "week_start",
    "index",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}