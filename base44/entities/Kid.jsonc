{
  "name": "Kid",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Kid's Name",
      "description": "The child's first name"
    },
    "age": {
      "type": "number",
      "title": "Kid's Age",
      "description": "The child's age \u2014 drives content difficulty",
      "default": 4
    },
    "program_length": {
      "type": "number",
      "title": "Program Length (weeks)",
      "description": "How many weeks the learning program runs",
      "default": 8
    },
    "developmental_milestone": {
      "type": "string",
      "title": "Developmental Milestone",
      "description": "The child's current developmental focus area"
    },
    "avatar_color": {
      "type": "string",
      "title": "Avatar Color",
      "default": "#4969E1"
    },
    "current_letter": {
      "type": "string",
      "title": "Current Target Letter",
      "description": "The letter the child is currently working on in articulation therapy. Starts at A and advances only once the sound is mastered.",
      "default": "A",
      "maxLength": 1
    },
    "parent_video_url": {
      "type": "string",
      "title": "Parent Cheer Video",
      "description": "A short recording of the parent saying the child's cheer (e.g. 'Yes! You did it, [name]!'), played at the end of each lesson.",
      "format": "uri"
    }
  },
  "required": [
    "name",
    "age"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}