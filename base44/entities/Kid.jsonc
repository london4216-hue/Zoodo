{
  "name": "Kid",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Kid's Name",
      "description": "The child's first name"
    },
    "age": {
      "type": "number",
      "title": "Kid's Age",
      "description": "The child's age \u2014 drives content difficulty",
      "default": 4
    },
    "program_length": {
      "type": "number",
      "title": "Program Length (weeks)",
      "description": "How many weeks the learning program runs",
      "default": 8
    },
    "developmental_milestone": {
      "type": "string",
      "title": "Developmental Milestone",
      "description": "The child's current developmental focus area"
    },
    "cheer_text": {
      "type": "string",
      "title": "Encouragement Saying",
      "description": "The cheer the grown-up says (and records) for the child, played back at the end of every lesson. Editable from the dashboard.",
      "default": "You did it!"
    },
    "avatar_color": {
      "type": "string",
      "title": "Avatar Color",
      "default": "#4969E1"
    },
    "current_letter": {
      "type": "string",
      "title": "Current Target Letter",
      "description": "The letter the child is currently working on in articulation therapy. Starts at A and advances only once the sound is mastered.",
      "default": "A",
      "maxLength": 1
    },
    "parent_videos": {
      "type": "array",
      "title": "Parent Cheer Videos",
      "description": "A cheer video from each parent (one or two), played at the end of every lesson so the child hears it from every grown-up.",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "name",
    "age"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}