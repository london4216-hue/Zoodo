{
  "name": "Kid",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Kid's Name",
      "description": "The child's first name"
    },
    "age": {
      "type": "number",
      "title": "Kid's Age",
      "description": "The child's age \u2014 drives content difficulty",
      "default": 4
    },
    "avatar_color": {
      "type": "string",
      "title": "Avatar Color",
      "default": "#4969E1"
    }
  },
  "required": [
    "name",
    "age"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}